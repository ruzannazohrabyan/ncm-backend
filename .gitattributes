# Force LF line endings for shell scripts — prevents Windows Git from
# converting to CRLF, which breaks shebangs inside Docker Linux containers.
*.sh        text eol=lf

# Standard rules for other file types
*.py        text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.env       text eol=lf
*.txt       text eol=lf
Dockerfile  text eol=lf
